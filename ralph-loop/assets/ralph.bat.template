@echo off
setlocal enabledelayedexpansion

set TOOL=%1
set MAX_ITER=%2
if "%TOOL%"=="" set TOOL=claude
if "%MAX_ITER%"=="" set MAX_ITER=10

set ITER=0

echo.
echo ============================================
echo   Ralph Loop - Starting %MAX_ITER% iterations
echo   Tool: %TOOL%
echo ============================================
echo.

:loop
if !ITER! geq !MAX_ITER! (
    echo.
    echo [ralph] Max iterations reached without completion.
    echo [ralph] Check prd.json for remaining stories and progress.txt for context.
    exit /b 1
)

set /a ITER+=1
echo.
echo --- Iteration !ITER! of !MAX_ITER! ---
echo.

if "!TOOL!"=="claude" (
    claude --dangerously-skip-permissions -p "Follow the instructions in prompt.md exactly. Do not summarize or describe it. Execute the workflow it describes: read prd.json, pick the next incomplete story, implement it, run quality gates, commit, and update progress. Begin immediately." > ralph_output.tmp 2>&1
) else if "!TOOL!"=="agy" (
    agy -p "Follow the instructions in prompt.md exactly. Do not summarize or describe it. Execute the workflow it describes: read prd.json, pick the next incomplete story, implement it, run quality gates, commit, and update progress. Begin immediately." > ralph_output.tmp 2>&1
) else (
    echo [ralph] Unknown tool: !TOOL!. Use "claude" or "agy".
    exit /b 1
)

echo --- Iteration !ITER! finished, continuing... ---

findstr /c:"<promise>COMPLETE</promise>" ralph_output.tmp >nul 2>&1
if !errorlevel! equ 0 (
    echo.
    echo [ralph] All stories complete!
    del ralph_output.tmp 2>nul
    exit /b 0
)

del ralph_output.tmp 2>nul
goto loop
